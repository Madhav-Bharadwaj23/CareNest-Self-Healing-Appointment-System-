<%- include('partials/head',{title}) %>
<%- include('partials/nav') %>
<%- include('partials/flash') %>

<main class="wrap page-main">
  <div class="page-heading">
    <div>
      <div class="eyebrow">OUR CARE TEAM</div>
      <h1>Meet your doctors.</h1>
      <p>Review doctor profiles and choose a specialist for your visit.</p>
    </div>
    <% if (currentUser?.role === 'patient') { %>
      <a class="btn" href="/appointments/new">Book a visit</a>
    <% } else if (!currentUser) { %>
      <a class="btn" href="/login">Sign in to book</a>
    <% } %>
  </div>

  <div class="doctor-grid doctor-grid-page">
    <% if (doctors.length) { %>
      <% doctors.forEach((doctor, index) => { %>
        <article class="doctor-card doctor-directory-card">
          <% const imageUrl = doctor.imageUrl || doctor.profileImage; %>
          <% if (imageUrl) { %>
            <img
              src="<%= imageUrl %>"
              alt="Profile photo of <%= doctor.name %>"
              class="doctor-avatar doctor-directory-photo"
              loading="lazy"
            >
          <% } else { %>
            <div class="doctor-avatar doctor-directory-photo doctor-photo-placeholder" aria-label="No profile photo uploaded">
              <i class="fa-regular fa-user" aria-hidden="true"></i>
            </div>
          <% } %>
          <div class="doctor-directory-info">
            <div class="doctor-directory-name-row">
              <h3><%= doctor.name %></h3>
              <span class="doctor-profile-badge" aria-label="CareNest doctor">
                <i class="fa-solid fa-user-doctor" aria-hidden="true"></i>
              </span>
            </div>
            <p class="doctor-specialty"><%= doctor.specialty %></p>
            <p class="muted doctor-experience"><i class="fa-solid fa-briefcase-medical" aria-hidden="true"></i><%= doctor.experience %> years experience</p>
            <% if (doctor.education) { %>
              <p class="muted doctor-education"><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i><%= doctor.education %></p>
            <% } %>
            <p class="doctor-hours"><i class="fa-regular fa-clock" aria-hidden="true"></i><%= formatDoctorAvailability(doctor) %></p>
          </div>
        </article>
      <% }) %>
    <% } else { %>
      <div class="empty-state">
        <h3>Doctor directory not set up yet</h3>
        <p>Doctors can register through the doctor portal.</p>
      </div>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>
