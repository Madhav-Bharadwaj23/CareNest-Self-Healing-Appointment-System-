<%- include('partials/head',{title}) %><%- include('partials/nav') %><%- include('partials/flash') %><main class="wrap page-main narrow-main"><div class="eyebrow">WE’RE HERE TO HELP</div><h1 class="display-title">How can we help?</h1><p class="large-copy">Send a message to the CareNest demo team. Your message is saved in the database for review; this starter does not send email.</p><section class="panel form-panel"><form action="/contact" method="post" class="stack-form"><label for="name">Your name</label><input id="name" name="name" required minlength="2"><label for="email">Email address</label><input id="email" name="email" type="email" required><label for="message">Message</label><textarea id="message" name="message" rows="5" required minlength="5"></textarea><button class="btn btn-full" type="submit">Send message →</button></form></section></main><%- include('partials/footer') %>
