<%
  const navLinkClass = path => currentPath === path
    ? 'border-b-2 border-teal-700 py-3 text-sm font-bold text-teal-800 lg:py-7'
    : 'py-3 text-sm font-semibold text-slate-600 transition hover:text-teal-700 lg:py-7';
  const accountHome = currentUser?.role === 'doctor'
    ? '/doctor/dashboard'
    : currentUser?.role === 'admin'
      ? '/admin'
      : '/dashboard';
%>
<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur-xl">
  <div class="mx-auto flex min-h-[76px] max-w-[1500px] items-center justify-between gap-3 px-4 sm:px-6 xl:px-10">
    <a href="/" class="flex shrink-0 items-center gap-3" aria-label="CareNest home">
      <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-teal-700 text-xl text-white shadow-lg shadow-teal-800/20">
        <i class="fa-solid fa-heart-pulse" aria-hidden="true"></i>
      </span>
      <span>
        <span class="brand-name block text-[23px] font-extrabold leading-tight tracking-tight text-slate-900">
          Care<span class="text-teal-700">Nest</span>
        </span>
        <span data-i18n="tagline" class="block text-[10px] font-bold uppercase tracking-[2px] text-slate-400">
          Care that feels closer
        </span>
      </span>
    </a>

    <nav aria-label="Main navigation" class="hidden items-center gap-6 lg:flex xl:gap-8">
      <a href="/doctors" data-i18n="findDoctor" class="<%= navLinkClass('/doctors') %>" <%- currentPath === '/doctors' ? 'aria-current="page"' : '' %>>
        Find a Doctor
      </a>
      <a href="/self-healing" class="<%= navLinkClass('/self-healing') %>" <%- currentPath === '/self-healing' ? 'aria-current="page"' : '' %>>
        Self-healing
      </a>
      <% if (currentUser?.role === 'patient') { %>
        <a href="/dashboard" class="<%= navLinkClass('/dashboard') %>" <%- currentPath === '/dashboard' ? 'aria-current="page"' : '' %>>
          Dashboard
        </a>
        <a href="/appointments" data-i18n="myAppointments" class="<%= navLinkClass('/appointments') %>" <%- currentPath === '/appointments' ? 'aria-current="page"' : '' %>>
          My Appointments
        </a>
      <% } else if (currentUser?.role === 'doctor') { %>
        <a href="/doctor/dashboard" data-i18n="doctorPortal" class="<%= navLinkClass('/doctor/dashboard') %>" <%- currentPath === '/doctor/dashboard' ? 'aria-current="page"' : '' %>>
          Doctor Portal
        </a>
        <a href="/doctor/schedule" class="<%= navLinkClass('/doctor/schedule') %>" <%- currentPath === '/doctor/schedule' ? 'aria-current="page"' : '' %>>
          My Schedule
        </a>
        <a href="/doctor/profile/edit" class="<%= navLinkClass('/doctor/profile/edit') %>" <%- currentPath === '/doctor/profile/edit' ? 'aria-current="page"' : '' %>>
          Edit Profile
        </a>
      <% } else if (currentUser?.role === 'admin') { %>
        <a href="/admin" class="<%= navLinkClass('/admin') %>" <%- currentPath === '/admin' ? 'aria-current="page"' : '' %>>
          Admin Dashboard
        </a>
      <% } else { %>
        <a href="/login" data-i18n="myAppointments" class="<%= navLinkClass('/login') %>" <%- currentPath === '/login' ? 'aria-current="page"' : '' %>>
          My Appointments
        </a>
      <% } %>
    </nav>

    <div class="flex shrink-0 items-center gap-2 sm:gap-3">
      <button
        id="languageToggle"
        type="button"
        class="rounded-xl border border-teal-700 px-3 py-2 text-sm font-bold text-teal-800 transition hover:bg-teal-50"
        aria-label="Change language"
      >
        हिन्दी
      </button>

      <div class="hidden items-center gap-3 lg:flex">
        <% if (currentUser) { %>
          <a href="<%= accountHome %>" class="max-w-40 truncate text-sm font-bold text-slate-700 hover:text-teal-700" title="<%= currentUser.fullName %>">
            <i class="fa-regular fa-user mr-1.5 text-teal-700" aria-hidden="true"></i><%= currentUser.fullName %>
          </a>
          <form action="/logout" method="post">
            <button type="submit" class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-bold text-slate-600 transition hover:border-red-200 hover:bg-red-50 hover:text-red-700">
              Log out
            </button>
          </form>
        <% } else { %>
          <a href="/doctor/login" class="rounded-xl px-3 py-2.5 text-sm font-bold text-teal-800 transition hover:bg-teal-50 sm:px-4">
            Doctor portal
          </a>
          <a href="/login" data-i18n="login" class="rounded-xl px-3 py-2.5 text-sm font-bold text-slate-600 transition hover:bg-slate-100 sm:px-4">
            Log in
          </a>
          <a href="/register" class=" inline-flex items-center gap-2 rounded-xl bg-teal-700 px-4 py-3 text-sm font-bold text-white shadow-md shadow-teal-800/15 transition hover:bg-teal-800">
            <i class="fa-regular fa-user !text-white" aria-hidden="true"></i>
            <span data-i18n="signup" class="!text-white">Sign up</span>
          </a>
        <% } %>
      </div>

      <button
        id="mobileMenuButton"
        type="button"
        class="flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 text-slate-700 lg:hidden"
        aria-label="Open navigation"
        aria-controls="mobileMenu"
        aria-expanded="false"
      >
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
      </button>
    </div>
  </div>

  <nav id="mobileMenu" aria-label="Mobile navigation" class="hidden border-t border-slate-100 bg-white px-5 py-3 lg:hidden">
    <a href="/doctors" data-i18n="findDoctor" class="block rounded-lg px-3 py-3 text-sm font-semibold <%= currentPath === '/doctors' ? 'bg-teal-50 text-teal-800' : 'text-slate-600 hover:bg-slate-50 hover:text-teal-700' %>" <%- currentPath === '/doctors' ? 'aria-current="page"' : '' %>>
      Find a Doctor
    </a>
    <a href="/self-healing" class="block rounded-lg px-3 py-3 text-sm font-semibold <%= currentPath === '/self-healing' ? 'bg-teal-50 text-teal-800' : 'text-slate-600 hover:bg-slate-50 hover:text-teal-700' %>" <%- currentPath === '/self-healing' ? 'aria-current="page"' : '' %>>
      Self-healing
    </a>
    <% if (currentUser?.role === 'patient') { %>
      <a href="/dashboard" class="block rounded-lg px-3 py-3 text-sm font-semibold <%= currentPath === '/dashboard' ? 'bg-teal-50 text-teal-800' : 'text-slate-600 hover:bg-slate-50 hover:text-teal-700' %>" <%- currentPath === '/dashboard' ? 'aria-current="page"' : '' %>>
        Dashboard
      </a>
      <a href="/appointments" data-i18n="myAppointments" class="block rounded-lg px-3 py-3 text-sm font-semibold <%= currentPath === '/appointments' ? 'bg-teal-50 text-teal-800' : 'text-slate-600 hover:bg-slate-50 hover:text-teal-700' %>" <%- currentPath === '/appointments' ? 'aria-current="page"' : '' %>>
        My Appointments
      </a>
    <% } else if (currentUser?.role === 'doctor') { %>
      <a href="/doctor/dashboard" data-i18n="doctorPortal" class="block rounded-lg px-3 py-3 text-sm font-semibold <%= currentPath === '/doctor/dashboard' ? 'bg-teal-50 text-teal-800' : 'text-slate-600 hover:bg-slate-50 hover:text-teal-700' %>" <%- currentPath === '/doctor/dashboard' ? 'aria-current="page"' : '' %>>
        Doctor Portal
      </a>
      <a href="/doctor/schedule" class="block rounded-lg px-3 py-3 text-sm font-semibold <%= currentPath === '/doctor/schedule' ? 'bg-teal-50 text-teal-800' : 'text-slate-600 hover:bg-slate-50 hover:text-teal-700' %>" <%- currentPath === '/doctor/schedule' ? 'aria-current="page"' : '' %>>
        My Schedule
      </a>
      <a href="/doctor/profile/edit" class="block rounded-lg px-3 py-3 text-sm font-semibold <%= currentPath === '/doctor/profile/edit' ? 'bg-teal-50 text-teal-800' : 'text-slate-600 hover:bg-slate-50 hover:text-teal-700' %>" <%- currentPath === '/doctor/profile/edit' ? 'aria-current="page"' : '' %>>
        Edit Profile
      </a>
    <% } else if (currentUser?.role === 'admin') { %>
      <a href="/admin" class="block rounded-lg px-3 py-3 text-sm font-semibold <%= currentPath === '/admin' ? 'bg-teal-50 text-teal-800' : 'text-slate-600 hover:bg-slate-50 hover:text-teal-700' %>" <%- currentPath === '/admin' ? 'aria-current="page"' : '' %>>
        Admin Dashboard
      </a>
    <% } else { %>
      <a href="/login" data-i18n="myAppointments" class="block rounded-lg px-3 py-3 text-sm font-semibold <%= currentPath === '/login' ? 'bg-teal-50 text-teal-800' : 'text-slate-600 hover:bg-slate-50 hover:text-teal-700' %>" <%- currentPath === '/login' ? 'aria-current="page"' : '' %>>
        My Appointments
      </a>
    <% } %>

    <div class="mt-2 border-t border-slate-100 pt-3">
      <% if (currentUser) { %>
        <div class="px-3 pb-2 text-sm font-bold text-slate-700">
          <i class="fa-regular fa-user mr-1.5 text-teal-700" aria-hidden="true"></i><%= currentUser.fullName %>
        </div>
        <form action="/logout" method="post" class="px-3 pb-2">
          <button type="submit" class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-left text-sm font-bold text-slate-600 hover:border-red-200 hover:bg-red-50 hover:text-red-700">
            Log out
          </button>
        </form>
      <% } else { %>
        <div class="flex gap-2 px-3 pb-2">
          <a href="/doctor/login" class="flex-1 rounded-xl border border-teal-200 px-4 py-2.5 text-center text-sm font-bold text-teal-800 hover:bg-teal-50">
            Doctor portal
          </a>
          <a href="/login" data-i18n="login" class="flex-1 rounded-xl border border-slate-200 px-4 py-2.5 text-center text-sm font-bold text-slate-600 hover:bg-slate-50">
            Log in
          </a>
          <a href="/register" class="flex-1 rounded-xl bg-teal-700 px-4 py-2.5 text-center text-sm font-bold text-white hover:bg-teal-800">
            <span data-i18n="signup">Sign up</span>
          </a>
        </div>
      <% } %>
    </div>
  </nav>
</header>
<% if (!databaseAvailable) { %>
  <div class="border-b border-amber-200 bg-amber-50 px-4 py-3 text-center text-sm font-semibold text-amber-900" role="status">
    The database is currently unavailable. Some features may be temporarily unavailable; please try again when connectivity is restored.
  </div>
<% } %>
