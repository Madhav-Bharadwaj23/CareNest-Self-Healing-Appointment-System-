
<%- include("partials/head") %>
<%- include("partials/nav") %>

<main class="booking-page mx-auto max-w-[1500px] px-4 py-7 sm:px-6 lg:py-10 xl:px-10">

  <!-- Welcome heading -->
  <section class="mb-8 flex flex-col justify-between gap-5 md:flex-row md:items-end">
    <div>
      <div class="mb-3 inline-flex items-center gap-2 rounded-full border border-teal-100 bg-teal-50 px-3 py-1.5 text-xs font-bold text-teal-800">
        <span class="h-2 w-2 rounded-full bg-teal-500"></span>
        YOUR HEALTH, OUR PRIORITY
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-[42px]">
        Find your right <span class="text-teal-700">doctor.</span>
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-500 sm:text-base">
        Book trusted specialists, choose a time that works for you, and make your next healthcare visit simpler.
      </p>
    </div>

    <div class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-white p-3.5 shadow-sm">
      <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-50 text-lg text-emerald-700">
        <i class="fa-solid fa-shield-heart"></i>
      </div>
      <div>
        <p class="text-sm font-extrabold text-slate-800">Care you can trust</p>
        <p class="mt-1 text-xs text-slate-500">Simple and accessible booking</p>
      </div>
    </div>
  </section>

  <!-- Search bar -->
  <section class="mb-7 rounded-2xl border border-slate-200 bg-white p-3 shadow-sm sm:p-4">
    <div class="grid gap-3 md:grid-cols-[1fr_220px_auto]">
      <label class="flex min-w-0 items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3.5 transition focus-within:border-teal-500 focus-within:bg-white">
        <i class="fa-solid fa-magnifying-glass text-slate-400"></i>
        <input id="doctorSearch" type="search" placeholder="Search doctor or speciality..." class="w-full bg-transparent text-sm font-medium outline-none placeholder:text-slate-400">
      </label>

      <label class="flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3.5">
        <i class="fa-solid fa-stethoscope text-teal-700"></i>
        <select id="departmentFilter" class="w-full bg-transparent text-sm font-semibold text-slate-600 outline-none">
          <option value="">All departments</option>
          <option value="Cardiology">Cardiology</option>
          <option value="Neurology">Neurology</option>
          <option value="Dermatology">Dermatology</option>
          <option value="Orthopedics">Orthopedics</option>
        </select>
      </label>

      <button id="searchButton" class="flex items-center justify-center gap-2 rounded-xl bg-teal-700 px-6 py-3.5 text-sm font-bold text-white transition hover:bg-teal-800">
        <i class="fa-solid fa-sliders"></i> Find a doctor
      </button>
    </div>
  </section>

  <!-- Dashboard layout -->
  <div class="grid items-start gap-6 xl:grid-cols-[270px_minmax(0,1fr)_320px]">

    <!-- LEFT: Date and calendar -->
    <aside class="space-y-5">
      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-100 px-5 py-5">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs font-bold uppercase tracking-widest text-teal-700">Step 01</p>
              <h2 class="mt-1 text-lg font-extrabold text-slate-900">Choose a date</h2>
            </div>
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-teal-50 text-teal-700">
              <i class="fa-regular fa-calendar-days"></i>
            </span>
          </div>
        </div>

        <div class="p-4">
          <div class="mb-4 flex items-center justify-between">
            <button id="prevWeek" class="flex h-9 w-9 items-center justify-center rounded-xl border border-slate-200 text-slate-500 transition hover:bg-slate-50" aria-label="Previous dates">
              <i class="fa-solid fa-chevron-left text-xs"></i>
            </button>
            <p id="calendarMonth" class="text-sm font-extrabold text-slate-800">Loading dates...</p>
            <button id="nextWeek" class="flex h-9 w-9 items-center justify-center rounded-xl border border-slate-200 text-slate-500 transition hover:bg-slate-50" aria-label="Next dates">
              <i class="fa-solid fa-chevron-right text-xs"></i>
            </button>
          </div>

          <div id="calendarDays" class="grid grid-cols-4 gap-2"></div>

          <div class="mt-5 rounded-xl bg-slate-50 p-3.5">
            <p class="text-xs font-bold text-slate-700">
              <i class="fa-regular fa-clock mr-1.5 text-teal-700"></i>
              Appointment hours
            </p>
            <p class="mt-1.5 text-xs leading-5 text-slate-500">Available times depend on each doctor's schedule.</p>
          </div>
        </div>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex items-center gap-3">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
            <i class="fa-solid fa-headset"></i>
          </span>
          <div>
            <h3 class="text-sm font-extrabold text-slate-900">Need help booking?</h3>
            <p class="mt-1 text-xs text-slate-500">We're here to help you.</p>
          </div>
        </div>
        <p class="mt-3 text-xs leading-5 text-slate-500">You can ask a family member to assist you with an appointment.</p>
        <button id="familyHelpButton" class="mt-4 w-full rounded-xl border border-slate-200 px-3 py-3 text-sm font-bold text-slate-700 transition hover:border-teal-300 hover:bg-teal-50 hover:text-teal-800">
          <i class="fa-solid fa-people-roof mr-2"></i>Family booking help
        </button>
      </section>
    </aside>

    <!-- CENTER: Doctors -->
    <section class="min-w-0">
      <div class="mb-4 flex items-end justify-between gap-3">
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-teal-700">Step 02</p>
          <h2 class="mt-1 text-xl font-extrabold text-slate-900 sm:text-2xl">Available specialists</h2>
          <p class="mt-1 text-sm text-slate-500">Select a doctor to see appointment times.</p>
        </div>
        <span id="doctorCount" class="shrink-0 rounded-full bg-white px-3 py-2 text-xs font-bold text-slate-500 ring-1 ring-slate-200">
          <%= doctors.length %> doctors
        </span>
      </div>

      <div id="doctorList" class="space-y-4">
        <% doctors.forEach((doctor, index) => { %>
          <article class="doctor-card <%= index === 0 ? 'selected' : '' %> cursor-pointer rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5"
                   data-doctor-id="<%= doctor.id %>"
                   data-name="<%= doctor.name %>"
                   data-specialty="<%= doctor.specialty %>"
                   data-department="<%= doctor.department %>"
                   data-fee="<%= doctor.fee %>"
                   data-rating="<%= doctor.rating %>"
                   data-experience="<%= doctor.experience %>"
                   data-image="<%= doctor.image %>"
                   tabindex="0" role="button" aria-pressed="<%= index === 0 ? 'true' : 'false' %>">

            <div class="booking-doctor-card-content flex gap-4">
              <div class="booking-doctor-photo-wrap relative shrink-0">
                <img src="<%= doctor.image %>" alt="Dr. <%= doctor.name %>" class="booking-doctor-photo h-[104px] w-[92px] rounded-xl bg-slate-100 object-cover sm:h-[118px] sm:w-[105px]" loading="lazy">
                <span class="absolute -bottom-2 -right-2 flex h-7 w-7 items-center justify-center rounded-full border-2 border-white bg-teal-600 text-xs text-white">
                  <i class="fa-solid fa-check"></i>
                </span>
              </div>

              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-start justify-between gap-2">
                  <div>
                    <h3 class="text-base font-extrabold text-slate-900 sm:text-lg"><%= doctor.name %></h3>
                    <p class="mt-1 text-sm font-semibold text-teal-700"><%= doctor.specialty %></p>
                  </div>
                  <span class="inline-flex items-center gap-1 rounded-lg bg-amber-50 px-2 py-1 text-xs font-extrabold text-amber-700">
                    <i class="fa-solid fa-star"></i> <%= doctor.rating %>
                  </span>
                </div>

                <div class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-xs text-slate-500">
                  <span><i class="fa-solid fa-briefcase-medical mr-1.5 text-slate-400"></i><%= doctor.experience %> years exp.</span>
                  <span><i class="fa-solid fa-hospital mr-1.5 text-slate-400"></i><%= doctor.department %></span>
                </div>

                <div class="mt-4 flex flex-wrap items-end justify-between gap-3 border-t border-slate-100 pt-3">
                  <div>
                    <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Consultation fee</p>
                    <p class="mt-0.5 text-lg font-extrabold text-slate-900">₹<%= doctor.fee %></p>
                  </div>
                  <button type="button" class="choose-doctor rounded-xl bg-teal-50 px-3.5 py-2.5 text-xs font-extrabold text-teal-800 transition hover:bg-teal-100">
                    Select doctor <i class="fa-solid fa-arrow-right ml-1"></i>
                  </button>
                </div>
              </div>
            </div>
          </article>
        <% }) %>
      </div>

      <div id="noDoctors" class="hidden rounded-2xl border border-dashed border-slate-300 bg-white px-5 py-12 text-center">
        <i class="fa-solid fa-user-doctor text-3xl text-slate-300"></i>
        <h3 class="mt-4 font-extrabold text-slate-800">No doctors found</h3>
        <p class="mt-2 text-sm text-slate-500">Try another name or department.</p>
      </div>
    </section>

    <!-- RIGHT: Selected doctor, slots, booking summary -->
    <aside class="space-y-5 xl:sticky xl:top-24">
      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="bg-gradient-to-br from-teal-800 to-teal-600 px-5 pb-8 pt-5 text-white">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-widest text-teal-100">Your selection</span>
            <i class="fa-solid fa-calendar-check text-xl text-teal-100"></i>
          </div>
          <h2 class="mt-2 text-xl font-extrabold">Book an appointment</h2>
          <p class="mt-1 text-xs leading-5 text-teal-100">Choose a suitable time for your visit.</p>
        </div>

        <div class="-mt-4 mx-3 rounded-xl border border-slate-100 bg-white p-4 shadow-sm">
          <div class="flex items-center gap-3">
            <img id="selectedDoctorImage" src="<%= doctors[0].image %>" alt="Selected doctor" class="h-14 w-14 rounded-xl bg-slate-100 object-cover">
            <div class="min-w-0">
              <p id="selectedDoctorName" class="text-sm font-extrabold text-slate-900"><%= doctors[0].name %></p>
              <p id="selectedDoctorSpecialty" class="mt-1 text-xs font-semibold text-teal-700"><%= doctors[0].specialty %></p>
              <p class="mt-1 text-xs text-slate-500"><i class="fa-solid fa-star mr-1 text-amber-400"></i><span id="selectedDoctorRating"><%= doctors[0].rating %></span> rating</p>
            </div>
          </div>
        </div>

        <div class="p-4">
          <div class="mb-3 flex items-center justify-between">
            <h3 class="text-sm font-extrabold text-slate-900">Available time slots</h3>
            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Select one</span>
          </div>

          <div class="mb-3 flex items-center gap-2 text-xs text-slate-500">
            <span class="h-2 w-2 rounded-full bg-teal-600"></span> Demo availability
          </div>

          <div id="timeSlots" class="grid grid-cols-2 gap-2"></div>

          <p id="slotHint" class="mt-3 text-xs leading-5 text-slate-500">
            Select a time slot to continue.
          </p>

          <div class="my-5 border-t border-dashed border-slate-200"></div>

          <h3 class="text-sm font-extrabold text-slate-900">Appointment summary</h3>
          <div class="mt-4 space-y-3 text-sm">
            <div class="flex items-start justify-between gap-3">
              <span class="text-slate-500"><i class="fa-regular fa-calendar mr-2 text-slate-400"></i>Date</span>
              <span id="summaryDate" class="text-right font-bold text-slate-800">Choose a date</span>
            </div>
            <div class="flex items-start justify-between gap-3">
              <span class="text-slate-500"><i class="fa-regular fa-clock mr-2 text-slate-400"></i>Time</span>
              <span id="summaryTime" class="text-right font-bold text-slate-800">Choose a slot</span>
            </div>
            <div class="flex items-start justify-between gap-3">
              <span class="text-slate-500"><i class="fa-solid fa-user-doctor mr-2 text-slate-400"></i>Doctor fee</span>
              <span id="summaryFee" class="text-right font-extrabold text-slate-900">₹<%= doctors[0].fee %></span>
            </div>
          </div>

          <button id="continueBooking" type="button" disabled class="mt-5 flex w-full items-center justify-center gap-2 rounded-xl bg-teal-700 px-4 py-3.5 text-sm font-extrabold text-white shadow-lg shadow-teal-800/15 transition hover:bg-teal-800 disabled:cursor-not-allowed disabled:bg-slate-200 disabled:text-slate-400 disabled:shadow-none">
            Continue to booking <i class="fa-solid fa-arrow-right"></i>
          </button>

          <p class="mt-3 text-center text-[10px] leading-4 text-slate-400">
            <i class="fa-solid fa-lock mr-1"></i>Demo only — no appointment is confirmed by this screen.
          </p>
        </div>
      </section>

      <section class="flex gap-3 rounded-2xl border border-emerald-100 bg-emerald-50/80 p-4">
        <i class="fa-solid fa-circle-check mt-0.5 text-emerald-700"></i>
        <div>
          <h3 class="text-xs font-extrabold text-emerald-900">Accessible healthcare</h3>
          <p class="mt-1 text-xs leading-5 text-emerald-800">Clear appointment details help you review your selection before continuing.</p>
        </div>
      </section>
    </aside>
  </div>

  <!-- Demo confirmation panel -->
  <section id="bookingDetails" class="booking-review mt-7 hidden rounded-2xl border border-teal-200 bg-white p-5 shadow-sm sm:p-7">
    <div class="mb-6">
      <p class="text-xs font-bold uppercase tracking-widest text-teal-700">Final step</p>
      <h2 class="mt-1 text-2xl font-extrabold text-slate-900">A few details about you</h2>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500">Review your doctor and visit, then enter the patient's contact details.</p>
    </div>

    <div class="patient-details-layout">
      <div class="review-doctor-card">
        <img id="reviewDoctorImage" src="<%= doctors[0].image %>" alt="Selected doctor">
        <div class="min-w-0">
          <p class="review-doctor-label">Your selected specialist</p>
          <h3 id="reviewDoctorName"><%= doctors[0].name %></h3>
          <p id="reviewDoctorSpecialty"><%= doctors[0].specialty %></p>
        </div>
      </div>

      <form id="demoBookingForm" class="patient-details-form">
        <label for="patientName" class="text-sm font-bold text-slate-700">
          Patient full name
          <input id="patientName" required maxlength="100" autocomplete="name" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 font-normal outline-none transition focus:border-teal-500 focus:bg-white" placeholder="Enter full name">
        </label>

        <label for="patientPhone" class="text-sm font-bold text-slate-700">
          Phone number
          <input id="patientPhone" required type="tel" inputmode="tel" pattern="[0-9 +()-]{8,18}" autocomplete="tel" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 font-normal outline-none transition focus:border-teal-500 focus:bg-white" placeholder="Enter phone number">
        </label>

        <div class="selected-appointment-summary">
          <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Selected appointment</p>
          <p id="reviewDetails" class="mt-2 text-sm font-extrabold leading-6 text-slate-800"></p>
        </div>

        <div class="flex flex-wrap gap-3">
          <button type="submit" class="rounded-xl bg-teal-700 px-5 py-3 text-sm font-extrabold text-white transition hover:bg-teal-800">
            Preview booking details
          </button>
          <button id="cancelReview" type="button" class="rounded-xl border border-slate-200 px-5 py-3 text-sm font-bold text-slate-600 transition hover:bg-slate-50">
            Cancel
          </button>
        </div>

        <p id="demoMessage" class="hidden rounded-xl bg-amber-50 p-4 text-sm leading-6 text-amber-900"></p>
      </form>
    </div>
  </section>

  <div class="mt-8 flex flex-col justify-between gap-3 border-t border-slate-200 pt-5 text-xs text-slate-400 sm:flex-row sm:items-center">
    <p>© <%= new Date().getFullYear() %> CareNest · Your health journey, made simpler.</p>
    <p><i class="fa-solid fa-lock mr-1"></i> Never enter payment details on this demo page.</p>
  </div>
</main>

<script id="doctorData" type="application/json"><%- JSON.stringify(doctors.map(d => ({ id: d.id, name: d.name, specialty: d.specialty, department: d.department, fee: d.fee, rating: d.rating, experience: d.experience, image: d.image }))).replace(/</g, '\\u003c') %></script>
<script src="/js/app.js" defer></script>
<%- include("partials/footer") %>
