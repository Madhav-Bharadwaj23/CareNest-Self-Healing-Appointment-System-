app.post('/admin/resolve/:id', requireAdmin, async (req, res) => {
  try {
    await Incident.updateOne(
      { _id: req.params.id },
      { $set: { resolved: true, resolvedAt: new Date() } }
    );

    flash(req, 'success', 'Incident marked as reviewed.');
  } catch (error) {
    await logIncident(
      'incident-resolve',
      'error',
      error.message,
      'Incident status could not be updated'
    );

    flash(req, 'error', 'Could not update incident.');
  }

  res.redirect('/admin');
});

// -------------------- HEALTH CHECK --------------------

app.get('/health', (req, res) => {
  const databaseConnected = mongoose.connection.readyState === 1;

  res.status(databaseConnected ? 200 : 503).json({
    service: 'hospital-api',
    status: databaseConnected ? 'healthy' : 'degraded',
    database: databaseConnected ? 'connected' : 'disconnected',
    timestamp: new Date().toISOString()
  });
});

// -------------------- ERROR HANDLING --------------------

app.use((req, res) => {
  res.status(404).render('404', {
    title: 'Page Not Found'
  });
});

app.use(async (error, req, res, next) => {
  try {
    await logIncident(
      'express-unhandled-error',
      'error',
      error.message,
      'Request handled by safe error page'
    );
  } catch (logError) {
    console.error('Could not log incident:', logError.message);
  }

  if (res.headersSent) {
    return next(error);
  }

  res.status(500).render('500', {
    title: 'Temporary Issue'
  });
});

// -------------------- START SERVER --------------------

async function start() {
  mongoose.connection.on('connected', () => {
    console.log('MongoDB connected/reconnected');
  });

  mongoose.connection.on('disconnected', () => {
    console.error('MongoDB disconnected');

    logIncident(
      'mongodb-disconnect',
      'error',
      'MongoDB connection lost',
      'Mongoose connection manager will attempt reconnection'
    ).catch(console.error);
  });

  mongoose.connection.on('error', error => {
    logIncident(
      'mongodb-error',
      'error',
      error.message,
      'Connection retry handled by Mongoose'
    ).catch(console.error);
  });

  try {
    await mongoose.connect(
      process.env.MONGODB_URI ||
      'mongodb://127.0.0.1:27017/carenest_hospital'
    );

    console.log('MongoDB connected');

    await logIncident(
      'startup',
      'info',
      'CareNest server started',
      'Initial health check completed'
    );
  } catch (error) {
    console.error('MongoDB connection failed:', error.message);

    try {
      await logIncident(
        'mongodb-connect',
        'critical',
        error.message,
        'Initial database connection failed'
      );
    } catch (logError) {
      console.error('Incident logging failed:', logError.message);
    }
  }

  startHealthMonitor();

  app.listen(PORT, () => {
    console.log(`CareNest running at http://localhost:${PORT}`);
  });
}

start();

