<% const databaseUnavailable = title === 'Database Temporarily Unavailable'; const chaosActive = title === 'Chaos Simulation Active'; %><%- include('partials/head',{title}) %><%- include('partials/nav') %><main class="wrap error-page"><div class="error-code"><%= databaseUnavailable || chaosActive ? '503' : '500' %></div><h1><%= databaseUnavailable ? 'Database temporarily unavailable.' : chaosActive ? 'Simulated service outage.' : 'CareNest hit a temporary issue.' %></h1><p><%= databaseUnavailable ? 'Database-backed pages and collection data are hidden until the connection is restored.' : chaosActive ? 'App services are temporarily disabled by the chaos. Turn self-healing on in the protected panel to recover.' : 'The issue has been recorded where possible. Please try again in a moment.' %></p><a class="btn" href="/self-healing">Open service recovery panel</a></main><%- include('partials/footer') %>
