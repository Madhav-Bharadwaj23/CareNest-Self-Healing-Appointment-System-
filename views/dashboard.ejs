<%- include('partials/head',{title}) %><%- include('partials/nav') %><%- include('partials/flash') %><main class="wrap page-main"><div class="page-heading"><div><div class="eyebrow">YOUR CARE SPACE</div><h1>Hello, <%= currentUser.fullName.split(' ')[0] %>.</h1><p>Here’s a simple overview of your recent care activity.</p></div><a class="btn" href="/appointments/new">+ Book appointment</a></div><div class="dashboard-grid"><section class="panel panel-wide"><div class="panel-heading"><div><h2>Upcoming & recent appointments</h2><p>Keep track of your visits in one place.</p></div><a class="text-link" href="/appointments">View all →</a></div><% if(appointments.length){ %><div class="appointment-list"><% appointments.forEach(a=>{ %><article class="appointment-row"><div class="date-tile"><b><%= new Date(a.appointmentDate).getDate() %></b><small><%= new Date(a.appointmentDate).toLocaleString('en',{month:'short'}) %></small></div><div class="appointment-info"><b><%= a.doctorId?a.doctorId.name:'Care team' %></b><span><%= a.doctorId?a.doctorId.specialty:'Appointment' %> · <%= a.patientName %></span><small><%= new Date(a.appointmentDate).toLocaleString() %></small></div><span class="pill pill-<%= a.status %>"><%= a.status %></span></article><% }) %></div><% }else{ %><div class="empty-state"><div class="empty-icon">▦</div><h3>No appointments yet</h3><p>Your booked visits will appear here.</p><a class="text-link" href="/appointments/new">Book your first appointment →</a></div><% } %></section><section class="panel"><div class="panel-heading"><div><h2>Quick actions</h2><p>Common tasks, made easy.</p></div></div><div class="action-stack"><a href="/appointments/new"><span>＋</span><div><b>Book a visit</b><small>Choose a doctor and date</small></div><i>→</i></a><a href="/queue"><span>◷</span><div><b>Queue status</b><small>Check waiting list position</small></div><i>→</i></a><a href="/self-healing"><span>⟳</span><div><b>Service health</b><small>See current monitor state</small></div><i>→</i></a></div></section><section class="panel"><div class="panel-heading"><div><h2>Recent updates</h2><p>Appointment and care notices.</p></div></div><% if(notifications.length){ notifications.forEach(n=>{ %><div class="notice-row"><span class="notice-dot"></span><div><p><%= n.message %></p><small><%= new Date(n.createdAt).toLocaleString() %></small></div></div><% }) }else{ %><p class="muted">No new updates yet. Booking an appointment will add a notice here.</p><% } %></section><section class="panel"><div class="panel-heading"><div><h2>Need a flexible time?</h2><p>Join the waiting list for a doctor.</p></div></div><form action="/waiting-list" method="post" class="stack-form"><label for="waitDoctor">Preferred doctor</label><select name="doctorId" id="waitDoctor" required><option value="">Choose a doctor</option><% doctors.forEach(d=>{ %><option value="<%= d._id %>"><%= d.name %> — <%= d.specialty %></option><% }) %></select><label for="waitDate">Preferred date (optional)</label><input type="date" name="preferredDate" id="waitDate"><label for="waitReason">Preference (optional)</label><input name="reason" id="waitReason" placeholder="Any flexible timing?"><button class="btn btn-outline btn-full" type="submit" <%= !doctors.length?'disabled':'' %>>Join waiting list</button><p class="form-note">Staff confirmation is required before a freed slot becomes a confirmed booking.</p></form></section></div></main><%- include('partials/footer') %>
