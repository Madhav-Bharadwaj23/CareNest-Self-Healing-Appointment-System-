<%- include('partials/head',{title}) %><%- include('partials/nav') %><%- include('partials/flash') %><main class="auth-page wrap"><section class="auth-aside"><div class="eyebrow">WELCOME TO CARENEST</div><h1><%= mode==='register'?'A little more care, all in one place.':'Welcome back to your care space.' %></h1><p>Manage appointments at your own pace, with simple language and helpful updates.</p><div class="auth-points"><span>✓ Secure patient account</span><span>✓ Family appointment booking</span><span>✓ Appointment history in one place</span></div><div class="auth-decoration">✚</div></section><section class="auth-card"><div class="auth-tabs"><a class="<%= mode==='login'?'selected':'' %>" href="/login">Sign in</a><a class="<%= mode==='register'?'selected':'' %>" href="/register">Create account</a></div><div id="authMessage" class="inline-message" role="status"></div><form id="authForm" data-mode="<%= mode %>"><% if(mode==='register'){ %><label for="fullName">Full name</label><input id="fullName" name="fullName" autocomplete="name" placeholder="e.g. Asha Sharma" required minlength="2"><label for="phone">Phone number</label><input id="phone" name="phone" autocomplete="tel" placeholder="Your contact number" required minlength="7"><% } %><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="<%= mode==='login'?'current-password':'new-password' %>" placeholder="<%= mode==='register'?'At least 8 characters':'Enter your password' %>" required <%= mode==='register'?'minlength="8"':'' %>><% if(mode==='register'){ %><label for="confirmPassword">Confirm password</label><input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" placeholder="Type password again" required minlength="8"><% } %><button class="btn btn-full" id="authSubmit" type="submit"><%= mode==='register'?'Create my account':'Sign in securely' %> <span>→</span></button><p class="form-note">Demo project: use a password you don't use elsewhere. This is not a production hospital portal.</p></form></section></main><%- include('partials/footer') %>
